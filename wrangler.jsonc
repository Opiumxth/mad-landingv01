{
  // Worker mínimo + assets estáticos de Astro (dist/).
  // Solo /api/* pasa primero por el Worker; el resto lo sirve Cloudflare directo.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mad-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mad-leads",
      // TODO: reemplazar con el id real que imprime `wrangler d1 create mad-leads`
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // Orígenes permitidos para POST /api/lead
    "ALLOWED_ORIGINS": "https://somosmad.com"
  }
  // Secreto (NO va aquí): TURNSTILE_SECRET_KEY -> `wrangler secret put TURNSTILE_SECRET_KEY`
  // En local se usa .dev.vars (ver .dev.vars.example)
}
