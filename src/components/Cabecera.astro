---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mad-blanco.webp';
import { SITIO } from '../data/sitio';
interface Enlace { texto: string; href: string }
interface Props { enlaces?: Enlace[]; contacto?: boolean }
const { enlaces = [], contacto = true } = Astro.props;
const conMenu = enlaces.length > 0;
---
<header class="cab tono-oscuro">
  <div class="cont cab__fila">
    <a class="cab__logo" href="/" aria-label={`${SITIO.nombre}, inicio`}>
      <Image src={logo} alt="" width={40} height={40} widths={[40, 80]} sizes="40px" loading="eager" />
      <span class="marca">{SITIO.nombre}</span>
    </a>

    {conMenu && (
      <>
        <nav class="cab__nav" aria-label="Principal">
          <ul>{enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}</ul>
        </nav>
        {contacto && <a class="btn btn--borde cab__cta" href="#formulario">Contacto</a>}

        <button type="button" class="cab__burger" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path class="b-arriba" d="M4 7h16" /><path class="b-medio" d="M4 12h16" /><path class="b-abajo" d="M4 17h16" />
          </svg>
        </button>
        <div id="menu-movil" class="cab__panel" hidden>
          <ul class="cont">
            {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
            {contacto && <li><a class="btn btn--borde" href="#formulario">Contacto</a></li>}
          </ul>
        </div>
      </>
    )}
  </div>
</header>

<script>
  // Menú móvil accesible: aria-expanded, Escape, foco atrapado mientras está abierto, cierra al elegir un enlace.
  const burger = document.querySelector<HTMLButtonElement>('.cab__burger');
  const panel = document.getElementById('menu-movil');
  if (burger && panel) {
    const items = () => Array.from(panel.querySelectorAll<HTMLElement>('a'));
    const abierto = () => burger.getAttribute('aria-expanded') === 'true';
    function abrir() {
      burger!.setAttribute('aria-expanded', 'true');
      burger!.setAttribute('aria-label', 'Cerrar menú');
      panel!.hidden = false;
      items()[0]?.focus();
    }
    function cerrar(devolverFoco = true) {
      burger!.setAttribute('aria-expanded', 'false');
      burger!.setAttribute('aria-label', 'Abrir menú');
      panel!.hidden = true;
      if (devolverFoco) burger!.focus();
    }
    burger.addEventListener('click', () => (abierto() ? cerrar() : abrir()));
    panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) cerrar(false); });
    document.addEventListener('keydown', (e) => {
      if (!abierto()) return;
      if (e.key === 'Escape') { e.preventDefault(); cerrar(); return; }
      if (e.key === 'Tab') {
        const ciclo = [burger, ...items()];
        const i = ciclo.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        const sig = e.shiftKey ? (i <= 0 ? ciclo.length - 1 : i - 1) : (i === ciclo.length - 1 ? 0 : i + 1);
        ciclo[sig].focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (abierto() && !(e.target as HTMLElement).closest('.cab')) cerrar(false);
    });
    window.matchMedia('(min-width: 56rem)').addEventListener('change', (m) => { if (m.matches && abierto()) cerrar(false); });
  }
</script>

<style>
  .cab { position: sticky; top: 0; z-index: 40; background: var(--negro); color: var(--texto-osc); border-bottom: 1px solid var(--borde); }
  .cab__fila { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); min-height: var(--alto-cabecera); }
  .cab__logo { display: inline-flex; align-items: center; gap: var(--sp-3); text-decoration: none; }
  .cab__logo img { width: 40px; height: 40px; }
  .cab__nav, .cab__cta { display: none; }
  .cab__nav ul { display: flex; gap: var(--sp-6); }
  .cab__nav a { display: inline-block; padding-block: var(--sp-3); font-weight: var(--peso-texto-fuerte); font-size: var(--fs-pequeno); text-decoration: none; }
  .cab__nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .cab__cta { min-height: 2.75rem; padding: var(--sp-2) var(--sp-5); font-size: var(--fs-pequeno); }
  .cab__burger { display: inline-grid; place-items: center; width: 3rem; height: 3rem; margin-right: -0.5rem; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
  .cab__burger svg path { transition: transform var(--t-medio) var(--easing), opacity var(--t-rapido); transform-origin: center; transform-box: fill-box; }
  .cab__burger[aria-expanded='true'] .b-arriba { transform: translateY(5px) rotate(45deg); }
  .cab__burger[aria-expanded='true'] .b-medio { opacity: 0; }
  .cab__burger[aria-expanded='true'] .b-abajo { transform: translateY(-5px) rotate(-45deg); }
  .cab__panel { position: absolute; top: 100%; left: 0; right: 0; background: var(--negro); border-bottom: 1px solid var(--borde); padding-block: var(--sp-4) var(--sp-5); }
  .cab__panel[hidden] { display: none; }
  .cab__panel ul { display: grid; gap: var(--sp-1); }
  .cab__panel li > a:not(.btn) { display: flex; align-items: center; min-height: var(--alto-tactil); font-size: var(--fs-medio); font-weight: var(--peso-texto-fuerte); text-decoration: none; }
  .cab__panel .btn { width: 100%; margin-top: var(--sp-3); }
  @media (min-width: 56rem) {
    .cab__nav, .cab__cta { display: block; }
    .cab__cta { display: inline-flex; }
    .cab__burger, .cab__panel { display: none; }
    .cab__fila { gap: var(--sp-6); }
    .cab__nav { margin-left: auto; }
  }
</style>
