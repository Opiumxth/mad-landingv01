---
// Iconos SVG propios (trazo, 24x24). Decorativos: aria-hidden.
interface Props { nombre: 'chat' | 'play' | 'mas' | 'flecha'; tam?: number }
const { nombre, tam = 24 } = Astro.props;
const trazos = {
  chat: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z',
  play: 'M6 4l14 8-14 8z',
  mas: 'M12 5v14M5 12h14',
  flecha: 'M5 12h14M13 6l6 6-6 6',
};
---
<svg width={tam} height={tam} viewBox="0 0 24 24" fill={nombre === 'play' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={trazos[nombre]} /></svg>
