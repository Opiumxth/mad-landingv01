---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mad-blanco.webp';
import { REDES, SITIO, enlaceWhatsApp } from '../data/sitio';
interface Props { whatsappMensaje: string }
const { whatsappMensaje } = Astro.props;
---
<footer class="pie tono-suave">
  <div class="cont pie__fila">
    <div class="pie__marca">
      <span class="pie__logo"><Image src={logo} alt="" width={40} height={40} widths={[40, 80]} sizes="40px" loading="lazy" /></span>
      <p>
        <span class="marca">{SITIO.nombre}</span><br />
        <span class="pie__suave">© {SITIO.anio} · [TODO: razón social y RUC del titular]</span>
      </p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="pie__links">
        <li><a href={SITIO.instagramUrl} rel="noopener">Instagram {REDES[0].texto}</a></li>
        <li><a href={enlaceWhatsApp(whatsappMensaje)} rel="noopener">WhatsApp {SITIO.whatsappVisible}</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .pie { padding-block: var(--sp-7); border-top: 1px solid var(--borde); }
  .pie__fila { display: grid; gap: var(--sp-5); }
  .pie__marca { display: flex; align-items: center; gap: var(--sp-4); }
  .pie__logo { display: block; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--negro); overflow: hidden; }
  .pie__marca img { width: 40px; height: 40px; }
  .pie__suave { display: inline-block; margin-top: var(--sp-1); color: var(--suave); font-size: var(--fs-pequeno); }
  .pie__links { display: flex; flex-wrap: wrap; gap: var(--sp-1) var(--sp-6); }
  .pie__links a { display: inline-block; padding-block: var(--sp-2); }
  @media (min-width: 62rem) { .pie__fila { grid-template-columns: 1fr auto; align-items: center; } }
</style>
