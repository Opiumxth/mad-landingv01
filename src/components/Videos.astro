---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['videos'] }
const { copy } = Astro.props;
---
<section class="seccion tono-oscuro" id="videos">
  <div class="cont">
    <header class="seccion__cab">
      <p class="etiqueta">{copy.etiqueta}</p>
      <h2>{copy.titulo}</h2>
      <p class="lead">{copy.lead}</p>
    </header>
    <div class="vid-grid">
      {copy.items.map((v) => (
        <figure class="vid" data-video-url={v.url}>
          <div class="vid__caja">
            <button type="button" class="vid__marco" data-video-btn aria-label={`Cargar el video: ${v.titulo}`}>
              <Image src={v.poster} alt="" width={1920} height={1200} widths={[480, 720, 1000]} sizes="(min-width: 48rem) 50vw, 100vw" loading="lazy" decoding="async" />
              <span class="vid__play"><Icono nombre="play" tam={28} /></span>
            </button>
            <span class="vid__chip etiqueta">Demo de MAD · {v.duracion}</span>
          </div>
          <figcaption>
            <span class="etiqueta vid__tipo">{v.etiqueta}</span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
            <p class="vid__aviso" hidden data-video-aviso>[Video por subir] Pega la URL en src/data/videos.ts.</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  // Carga al tocar: nada se descarga ni se reproduce hasta que la persona lo pide.
  document.querySelectorAll<HTMLElement>('[data-video-url]').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('[data-video-btn]')!;
    btn.addEventListener('click', () => {
      const url = fig.dataset.videoUrl ?? '';
      if (!url) {
        fig.querySelector<HTMLElement>('[data-video-aviso]')!.hidden = false;
        return;
      }
      let el: HTMLElement;
      if (/\.(mp4|webm)(\?|$)/i.test(url)) {
        const v = document.createElement('video');
        v.src = url; v.controls = true; v.playsInline = true; v.preload = 'metadata';
        el = v;
      } else {
        const f = document.createElement('iframe');
        f.src = url; f.title = btn.getAttribute('aria-label') ?? 'Video';
        f.allow = 'encrypted-media; picture-in-picture'; f.allowFullscreen = true;
        el = f;
      }
      el.className = 'vid__media';
      btn.replaceWith(el);
      el.focus?.();
      if (el instanceof HTMLVideoElement) el.play().catch(() => {}); // acción directa del toque
    });
  });
</script>

<style>
  .vid-grid { display: grid; gap: var(--sp-7); }
  .vid { display: grid; gap: var(--sp-4); }
  .vid__marco, .vid :global(.vid__media) {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 10; padding: 0; overflow: hidden;
    border: 1px solid var(--borde); border-radius: var(--radio-lg); background: var(--negro-2); cursor: pointer;
  }
  .vid__marco :global(img) { width: 100%; height: 100%; object-fit: cover; transition: filter var(--t-medio); }
  .vid__marco:hover :global(img) { filter: brightness(0.92); }
  .vid__play {
    position: absolute; inset: 0; margin: auto; width: 4.5rem; height: 4.5rem; display: grid; place-items: center;
    border-radius: var(--radio); background: var(--blanco); color: var(--negro); padding-left: 4px;
  }
  .vid__caja { position: relative; }
  .vid__chip { pointer-events: none; position: absolute; left: var(--sp-3); bottom: var(--sp-3); padding: var(--sp-1) var(--sp-3); background: var(--negro); color: var(--texto-osc); border-radius: var(--radio-sm); font-size: var(--fs-etiqueta-min); }
  .vid__tipo { color: var(--texto-osc-suave); }
  figcaption { display: grid; gap: var(--sp-2); }
  figcaption p:not(.vid__aviso) { color: var(--suave); max-width: 36rem; }
  .vid__aviso { color: var(--texto-osc); font-family: var(--f-mono); font-size: var(--fs-pequeno); }
  @media (min-width: 48rem) { .vid-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-6); } }
</style>
