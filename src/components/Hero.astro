---
import { Image } from 'astro:assets';
import sitio from '../assets/demo/sitio-inicio.webp';
import panel from '../assets/demo/panel-movil.webp';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['hero'] }
const { copy } = Astro.props;
---
<!--
  Hero 3 (por defecto): fondo blanco, texto a la izquierda y el demo de MAD en marcos de dispositivo
  (ventana de navegador para el sitio, celular para el panel) con sombra suave. Capturas a doble resolución,
  sin la barra de herramientas del demo. Los marcos son CSS puro (sin imágenes extra).
  Hero 4 (?hero=4): mismos textos y estructura; mockups ~20% más grandes con más profundidad (brillo y sombra de apoyo,
  celular superpuesto), fondo de cuadrícula fina con máscara radial en CSS y entrada de los mockups en < 400 ms
  (solo fundido + desplazamiento corto; el H1 y el botón nunca parten invisibles; se apaga con prefers-reduced-motion).
  Hero 2 (?hero=2): imagen de fondo con capa oscura, texto centrado.
-->
<section class="hero" id="inicio">
  <div class="hero__bg" aria-hidden="true">
    <Image src={sitio} alt="" width={1920} height={1200} widths={[800, 1440]} sizes="100vw" loading="lazy" decoding="async" />
    <div class="hero__capa"></div>
    <p class="hero__nota etiqueta">Fondo: captura de una demo de MAD</p>
  </div>

  <div class="hero__fondo" aria-hidden="true"></div>

  <div class="cont hero__grid">
    <div class="hero__texto">
      <h1>{copy.h1}</h1>
      <p class="lead hero__sub">{copy.sub}</p>
      <div class="hero__cta">
        <a class="btn btn--principal" href="#formulario">{copy.cta}</a>
        <p class="hero__micro">{copy.micro}</p>
      </div>
    </div>

    <div class="escena">
      <div class="escena__lienzo">
        <figure class="navegador">
          <div class="navegador__barra" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
          <Image src={sitio} alt="Demo de MAD: sitio web de un salón con su carta de servicios y botón de reserva (captura de ejemplo)" width={1920} height={1200} widths={[640, 960, 1280, 1600]} sizes="(min-width: 62rem) 44rem, 92vw" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
        <figure class="celular">
          <Image src={panel} alt="Demo de MAD: panel del salón en el celular, con las citas por confirmar (captura de ejemplo)" width={780} height={1688} widths={[160, 320, 480]} sizes="(min-width: 62rem) 9rem, 30vw" loading="lazy" decoding="async" />
        </figure>
      </div>
      <p class="escena__pie etiqueta">Demo de MAD · sitio web y panel de ejemplo</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow-x: clip; background: var(--blanco); color: var(--texto-claro); --suave: var(--texto-claro-suave); padding-block: clamp(2.5rem, 6vw, 5rem) var(--seccion-y); }
  .hero__bg { display: none; position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .hero__bg :global(img) { width: 100%; height: 100%; object-fit: cover; filter: blur(6px); transform: scale(1.05); }
  .hero__capa { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.78); }
  .hero__nota { position: absolute; left: var(--gutter); bottom: var(--sp-4); margin: 0; color: var(--texto-osc-suave); font-size: var(--fs-etiqueta-min); }

  .hero__grid { position: relative; z-index: 1; display: grid; gap: var(--sp-7); }
  .hero__texto { display: grid; justify-items: start; align-content: center; gap: var(--sp-5); }
  .hero__texto h1 { font-size: var(--fs-h1-hero); max-width: 16ch; }
  .hero__sub { color: var(--suave); max-width: 30rem; }
  .hero__cta { display: grid; justify-items: start; gap: var(--sp-3); margin-top: var(--sp-2); }
  .hero__micro { font-size: var(--fs-pequeno); color: var(--suave); }

  /* ---- Escena: ventana de navegador + celular ---- */
  .escena { display: grid; gap: var(--sp-4); min-width: 0; }
  .escena__lienzo { position: relative; padding-bottom: var(--sp-6); }
  figure { margin: 0; }
  .navegador { width: 80%; background: var(--blanco); border: 1px solid var(--gris-linea); border-radius: var(--radio-lg); box-shadow: var(--sombra-marco); overflow: hidden; }
  .navegador__barra { display: flex; align-items: center; gap: 0.375rem; height: 1.75rem; padding-inline: var(--sp-3); background: var(--gris-suave); border-bottom: 1px solid var(--gris-linea); }
  .navegador__barra i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #bdbdbd; }
  .navegador__barra span { flex: 1; max-width: 55%; height: 0.875rem; margin-left: var(--sp-3); border-radius: 999px; background: var(--blanco); border: 1px solid var(--gris-linea); }
  .navegador :global(img) { width: 100%; height: auto; }
  .celular {
    position: absolute; right: 0; bottom: 0; width: 28%;
    padding: 0.3rem; background: var(--negro); border-radius: clamp(0.875rem, 4.5vw, var(--radio-celular));
    box-shadow: var(--sombra-marco);
  }
  .celular :global(img) { width: 100%; height: auto; border-radius: clamp(0.625rem, 3.6vw, calc(var(--radio-celular) - 0.3rem)); }
  .escena__pie { color: var(--suave); font-size: var(--fs-etiqueta-min); }

  /* ---- Hero 2 (?hero=2): oscuro, centrado, sin escena ---- */
  :global(html[data-hero='2']) .hero { background: var(--negro); color: var(--texto-osc); --suave: var(--texto-osc-suave); min-height: calc(100svh - var(--alto-cabecera)); display: grid; align-items: center; padding-block: var(--sp-8); }
  :global(html[data-hero='2']) .hero__bg { display: block; }
  :global(html[data-hero='2']) .escena { display: none; }
  :global(html[data-hero='2']) .hero__fondo { display: none; }
  :global(html[data-hero='2']) .hero__texto { justify-items: center; text-align: center; }
  :global(html[data-hero='2']) .hero__texto h1 { max-width: 14ch; font-size: var(--fs-h1); }
  :global(html[data-hero='2']) .hero__cta { justify-items: center; }
  :global(html[data-hero='2']) .hero .btn--principal { border-color: var(--acento-borde-osc); }
  :global(html[data-hero='2']) .hero :global(:focus-visible) { outline-color: var(--blanco); box-shadow: 0 0 0 6px var(--negro); }

  @media (min-width: 40rem) { .celular { width: 24%; padding: 0.375rem; } .navegador { width: 84%; } }
  @media (min-width: 62rem) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--sp-7); align-items: center; }
    .celular { width: 22%; }
    .navegador { width: 86%; }
  }

  /* ================= Hero 4 (?hero=4) ================= */
  .hero__fondo { display: none; }
  :global(html[data-hero='4']) .hero__fondo {
    display: block; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    /* Cuadrícula fina + resplandor suave; la máscara la desvanece hacia el texto (idea: cuadrícula con máscara radial) */
    background-image:
      radial-gradient(46rem 30rem at 76% 38%, rgba(10, 10, 10, 0.055), transparent 70%),
      linear-gradient(to right, rgba(10, 10, 10, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.06) 1px, transparent 1px);
    background-size: auto, 3rem 3rem, 3rem 3rem;
    background-position: 0 0, -1px -1px, -1px -1px;
    -webkit-mask-image: radial-gradient(52rem 34rem at 76% 38%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 78%);
    mask-image: radial-gradient(52rem 34rem at 76% 38%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 78%);
  }
  :global(html[data-hero='4']) .escena__lienzo { padding-bottom: var(--sp-7); }
  /* Sombra de apoyo: da profundidad sin bloques de color */
  :global(html[data-hero='4']) .escena__lienzo::before {
    content: ''; position: absolute; z-index: 0; left: 6%; right: 2%; bottom: 0.75rem; height: 3rem;
    background: radial-gradient(closest-side, rgba(10, 10, 10, 0.26), transparent); filter: blur(10px);
  }
  :global(html[data-hero='4']) .navegador {
    position: relative; z-index: 1; width: 86%; border-color: rgba(10, 10, 10, 0.14); border-top-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 4px rgba(10, 10, 10, 0.08), 0 20px 40px -12px rgba(10, 10, 10, 0.22), 0 48px 90px -24px rgba(10, 10, 10, 0.3);
  }
  :global(html[data-hero='4']) .celular {
    z-index: 2; width: 34%; right: -1%; bottom: 1.25rem; padding: 0.4rem;
    box-shadow: 0 2px 4px rgba(10, 10, 10, 0.12), 0 24px 44px -10px rgba(10, 10, 10, 0.4), 0 56px 90px -28px rgba(10, 10, 10, 0.4);
  }
  :global(html[data-hero='4']) .celular :global(img) { border-radius: clamp(0.625rem, 3.6vw, calc(var(--radio-celular) - 0.4rem)); }

  /* Entrada de los mockups: fundido + 14px de desplazamiento, 320 ms (el celular entra 60 ms después: todo < 400 ms).
     Solo con movimiento permitido. El texto y el botón no se animan. */
  @keyframes hero4-entrada { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-hero='4']) .navegador { animation: hero4-entrada 320ms var(--easing) both; }
    :global(html[data-hero='4']) .celular { animation: hero4-entrada 320ms var(--easing) 60ms both; }
  }

  @media (min-width: 40rem) {
    :global(html[data-hero='4']) .navegador { width: 88%; }
    :global(html[data-hero='4']) .celular { width: 26%; right: 0; }
  }
  /* Escritorio: el bloque del hero se ensancha (1280 px) y el demo gana ~20% frente al hero 3 */
  @media (min-width: 62rem) {
    :global(html[data-hero='4']) .hero__grid { max-width: 80rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
    :global(html[data-hero='4']) .navegador { width: 88%; }
    :global(html[data-hero='4']) .celular { width: 25%; right: -1%; bottom: 1.5rem; }
  }
</style>
