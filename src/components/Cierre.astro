---
import EsferaPlateada from './EsferaPlateada.astro';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['cierre'] }
const { copy } = Astro.props;
---
<section class="seccion tono-oscuro cierre" id="cierre">
  <div class="cont cierre__in">
    <div class="cierre__texto">
      <h2>{copy.titulo}</h2>
      <p class="lead">{copy.texto}</p>
      <a class="btn btn--principal" href="#formulario">Pide tu demo con tu logo</a>
      <p class="cierre__micro">Sin costo · te escribimos por WhatsApp</p>
    </div>
    <div class="cierre__esfera"><EsferaPlateada /></div>
  </div>
</section>

<style>
  /* Cierre oscuro sobrio: degradado 120° y una esfera plateada entera al costado (nunca recortada) */
  .cierre { background: var(--degradado-oscuro); }
  .cierre__in { display: grid; gap: var(--sp-7); align-items: center; }
  .cierre__texto { display: grid; justify-items: start; gap: var(--sp-5); }
  .cierre h2 { max-width: 16ch; font-size: var(--fs-h1); font-weight: var(--peso-h1); letter-spacing: var(--ls-h1); line-height: var(--lh-h1); }
  .cierre .lead { color: var(--suave); }
  .cierre__micro { color: var(--suave); font-size: var(--fs-pequeno); }
  .cierre__esfera { width: min(55vw, 15rem); }
  @media (min-width: 62rem) {
    .cierre__in { grid-template-columns: 1.3fr 1fr; }
    .cierre__esfera { width: min(100%, 22rem); justify-self: center; }
  }
</style>
