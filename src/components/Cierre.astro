---
import FormaPlateada from './FormaPlateada.astro';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['cierre'] }
const { copy } = Astro.props;
---
<section class="seccion tono-oscuro cierre" id="cierre">
  <FormaPlateada />
  <div class="cont cierre__in">
    <h2>{copy.titulo}</h2>
    <p class="lead">{copy.texto}</p>
    <a class="btn btn--principal" href="#formulario">Pide tu demo con tu logo</a>
    <p class="cierre__micro">Sin costo · te escribimos por WhatsApp</p>
  </div>
</section>

<style>
  /* Cierre oscuro: degradado 120° #050505 → #161616 → #2a2a2a */
  .cierre { position: relative; overflow: hidden; background: var(--degradado-oscuro); }
  .cierre__in { position: relative; z-index: 1; display: grid; justify-items: start; gap: var(--sp-5); }
  .cierre h2 { max-width: 14ch; font-size: var(--fs-h1); font-weight: var(--peso-h1); letter-spacing: -0.035em; }
  .cierre .lead { color: var(--suave); }
  .cierre__micro { color: var(--suave); font-size: var(--fs-pequeno); }
</style>
