---
// Estructura común del embudo. / y /salones solo cambian el contenido (src/data/paginas.ts).
import Base from '../layouts/Base.astro';
import Cabecera from './Cabecera.astro';
import Hero from './Hero.astro';
import Videos from './Videos.astro';
import Como from './Como.astro';
import Precios from './Precios.astro';
import Condiciones from './Condiciones.astro';
import Formulario from './Formulario.astro';
import Faq from './Faq.astro';
import Cierre from './Cierre.astro';
import Pie from './Pie.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { mostrarPrecios } from '../data/precios';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy }
const { copy } = Astro.props;
const enlaces = [
  { texto: 'Demo', href: '#videos' },
  { texto: 'Cómo trabajamos', href: '#como-trabajamos' },
  ...(mostrarPrecios ? [{ texto: 'Precios', href: '#precios' }] : []),
  { texto: 'Preguntas', href: '#preguntas' },
];
---
<Base title={copy.title} description={copy.description} ruta={copy.ruta}>
  <Cabecera enlaces={enlaces} />
  <main id="contenido">
    <Hero copy={copy.hero} />
    <Videos copy={copy.videos} />
    <Como copy={copy.como} />
    <Precios copy={copy.precios} completo={copy.esSalones} />
    {copy.esSalones && <Condiciones copy={copy.condiciones} />}
    <Formulario copy={copy.form} rubroInicial={copy.rubroInicial} />
    <Faq copy={copy.faq} />
    <Cierre copy={copy.cierre} />
  </main>
  <Pie whatsappMensaje={copy.whatsappMensaje} />
  <BotonWhatsApp mensaje={copy.whatsappMensaje} />
</Base>
