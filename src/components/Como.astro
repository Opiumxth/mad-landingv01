---
import { etapas, nota3Semanas, type PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['como'] }
const { copy } = Astro.props;
---
<section class="seccion tono-claro" id="como-trabajamos">
  <div class="cont">
    <header class="seccion__cab">
      <p class="etiqueta">{copy.etiqueta}</p>
      <h2>{copy.titulo}</h2>
      <p class="lead">{copy.lead}</p>
    </header>
    <ol class="etapas">
      {etapas.map((h) => (
        <li class="etapa">
          <span class="etapa__n etiqueta">{h.n} · {h.cuando}</span>
          <h3>{h.titulo}</h3>
          <p>{h.texto}</p>
        </li>
      ))}
    </ol>
    <p class="nota">{nota3Semanas}</p>
  </div>
</section>

<style>
  .etapas { display: grid; border-top: 2px solid var(--texto-claro); }
  .etapa { display: grid; gap: var(--sp-2); padding-block: var(--sp-5); border-bottom: 1px solid var(--borde); }
  .etapa__n { color: var(--suave); }
  .etapa p { color: var(--suave); max-width: 32rem; }
  .nota { margin-top: var(--sp-5); color: var(--suave); font-size: var(--fs-pequeno); max-width: var(--ancho-texto); }
  @media (min-width: 62rem) {
    .etapas { grid-template-columns: repeat(3, 1fr); gap: var(--sp-6); border-top: 0; }
    .etapa { align-content: start; padding: var(--sp-5) 0 0; border: 0; border-top: 2px solid var(--texto-claro); }
  }
</style>
