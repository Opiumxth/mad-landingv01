---
import Icono from './Icono.astro';
import type { PaginaCopy } from '../data/paginas';
interface Props { copy: PaginaCopy['faq'] }
const { copy } = Astro.props;
---
<section class="seccion tono-claro" id="preguntas">
  <div class="cont faq">
    <header class="seccion__cab">
      <p class="etiqueta">{copy.etiqueta}</p>
      <h2>{copy.titulo}</h2>
    </header>
    <div class="faq__lista">
      {copy.items.map((it) => (
        // Acordeón nativo (<details>): funciona sin JavaScript y con teclado
        <details name="faq">
          <summary><span>{it.pregunta}</span><Icono nombre="mas" /></summary>
          <div class="faq__resp">
            <p>{it.respuesta}</p>
            {it.enlace && <p><a href={it.enlace.href}>{it.enlace.texto}</a></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: var(--sp-5); }
  .faq__lista { border-top: 2px solid var(--texto-claro); }
  details { border-bottom: 1px solid var(--borde); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);
    min-height: var(--alto-tactil); padding-block: var(--sp-5); cursor: pointer; list-style: none;
    font-weight: var(--peso-texto-fuerte); font-size: var(--fs-medio);
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; transition: transform var(--t-medio) var(--easing); }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq__resp { display: grid; gap: var(--sp-3); padding-bottom: var(--sp-5); color: var(--suave); max-width: var(--ancho-texto); }
  .faq__resp a { color: var(--texto-claro); font-weight: var(--peso-texto-fuerte); }
  @media (min-width: 62rem) { .faq { grid-template-columns: 1fr 1.6fr; gap: var(--sp-8); } .seccion__cab { align-content: start; } }
</style>
