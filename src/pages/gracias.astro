---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Cabecera from '../components/Cabecera.astro';
import { enlaceWhatsApp } from '../data/sitio';
const mensaje = 'Hola, acabo de dejar mis datos en somosmad.com para pedir mi demo con mi logo.';
---
<Base title="Gracias | MAD Software Studio" description="Recibimos tus datos. Te contactaremos por WhatsApp." ruta="/gracias" noindex jsonld={false}>
  <Cabecera />
  <main id="contenido" class="gracias tono-oscuro">
    <div class="cont gracias__in">
      <p class="etiqueta">Datos recibidos</p>
      <h1>Gracias, ya tenemos tus datos</h1>
      <p class="lead">Te contactaremos por el WhatsApp que dejaste para preparar tu demo con tu logo. [Confirmar plazo de respuesta]</p>
      <a class="btn btn--principal" href={enlaceWhatsApp(mensaje)}><Icono nombre="chat" /> Escríbenos por WhatsApp</a>
      <a class="gracias__volver" href="/">Volver al inicio</a>
    </div>
  </main>
</Base>

<style>
  .gracias { min-height: calc(100svh - var(--alto-cabecera)); display: grid; align-items: center; padding-block: var(--sp-8); text-align: center; }
  .gracias__in { display: grid; justify-items: center; gap: var(--sp-5); }
  .gracias h1 { font-size: var(--fs-h2); max-width: 16ch; }
  .gracias .lead { color: var(--suave); }
  .gracias__volver { padding-block: var(--sp-3); color: var(--suave); }
</style>
