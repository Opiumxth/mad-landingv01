---
// Una página por rubro, generada desde src/data/rubros/. Hoy: /salones.
import Embudo from '../components/Embudo.astro';
import { rubros } from '../data/rubros';
import { paginaDeRubro } from '../data/paginas';

export function getStaticPaths() {
  return rubros.map((r) => ({ params: { rubro: r.slug }, props: { copy: paginaDeRubro(r) } }));
}
const { copy } = Astro.props;
---
<Embudo copy={copy} />
