---
import '../styles/global.css';
import { SITIO } from '../data/sitio';

interface Props {
  title: string;
  description: string;
  ruta: string; // ej. "/salones"
  noindex?: boolean;
  jsonld?: boolean;
}
const { title, description, ruta, noindex = false, jsonld = true } = Astro.props;
const canonical = SITIO.dominio + ruta;
const og = `${SITIO.dominio}/og-default.png`;
const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITIO.nombre,
  url: SITIO.dominio,
  logo: `${SITIO.dominio}/favicon-512.png`,
  sameAs: [SITIO.instagramUrl, `https://wa.me/${SITIO.whatsappNumero}`],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: '+' + SITIO.whatsappNumero,
    availableLanguage: 'es',
  },
};
---
<!doctype html>
<html lang={SITIO.idioma} data-hero="3">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de MAD Software Studio sobre fondo negro" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Variante del hero: por defecto 3. ?hero=4 = mockups más grandes con fondo de líneas; ?hero=2 = imagen de fondo. Corre antes de pintar. -->
    <script is:inline>
      try {
        var h = new URLSearchParams(location.search).get('hero');
        if (h === '2' || h === '3' || h === '4') document.documentElement.setAttribute('data-hero', h);
      } catch (e) {}
    </script>

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />}
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
